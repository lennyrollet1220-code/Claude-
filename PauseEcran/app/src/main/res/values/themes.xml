<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.PauseEcran" parent="Theme.Material3.Light.NoActionBar" />

    <style name="Theme.PauseEcran" parent="Base.PauseEcran">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">#11185C</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PauseEcran.Block">
        <item name="android:windowBackground">@color/block_bg</item>
        <item name="android:statusBarColor">@color/block_bg</item>
        <item name="android:navigationBarColor">@color/block_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Card">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
